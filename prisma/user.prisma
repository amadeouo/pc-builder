model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  password String

  builds Build[]
  likes  Like[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  buildId String
  build   Build  @relation(fields: [buildId], references: [id])

  @@unique([userId, buildId])
}
